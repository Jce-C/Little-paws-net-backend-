DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
MYSQL_DATABASE=little_paws_net_v2
MYSQL_USER=lpn_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Para una conexión externa que requiera TLS, configure REQUIRED o verificación con CA propia.
MYSQL_SSL_MODE=
# Genere una clave Fernet propia antes de habilitar cuentas y referencias privadas.
LPN_DATA_KEY=
# Solo para la carga de datos sintéticos; nunca reutilizar en producción.
LPN_DEMO_PASSWORD=
# Solo habilitar en una base de presentación vacía cuyo nombre termine en _demo.
LPN_ALLOW_DEMO_SEED=0
# Procesos Uvicorn del contenedor. Empezar por uno; no implica un límite de facturación.
WEB_CONCURRENCY=1
